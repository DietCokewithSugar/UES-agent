# ============================================================
# 环境变量示例文件
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env.local（注意是 .env.local，不是 .env）：
#        cp .env.example .env.local
#   2. 把下面占位符替换成你自己的真实 Key
#   3. 重新启动开发服务：npm run dev
#
# 安全提示：
#   - .env.local 已被 .gitignore 忽略，不会被提交
#   - 千万不要把真实 Key 写在 .env.example 里
#   - DeepSeek 和 E2B Key 只由 Express 服务读取，不会写入浏览器构建产物
# ============================================================


# ------------------------------------------------------------
# DeepSeek （全站唯一模型来源：多模态体验评测 + AI 研究助手 + AI 分析助手）
# ------------------------------------------------------------
# 1. 打开 DeepSeek 开放平台：https://platform.deepseek.com/
# 2. 注册/登录账号（支持手机号、微信、Google 登录）
# 3. 充值少量额度（DeepSeek 价格很低，1 元就够调试很久）
# 4. 左侧菜单 → "API Keys" → "创建 API Key"
#    （官方文档：https://api-docs.deepseek.com/zh-cn/）
# 5. 生成后立即复制（页面只显示一次），形如：
#        sk-************************************
# 6. 粘贴到下面的等号后面，不要带引号、不要带空格
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# DeepSeek 视觉模型（可选）
# - 「多模态体验评测」上传界面截图、「AI 分析助手」上传图片（如眼动热区图）时都会用到
# - deepseek-v4-flash 只接文本，图片必须走视觉模型
# - 留空则使用默认值 deepseek-v4-flash-vision-exp；
#   如果你的账号里这个模型名不可用，在这里换成可用的名字即可，不用改代码
DEEPSEEK_VISION_MODEL=

# DeepSeek API Base URL（可选）
# - 默认值即官方地址，无特殊需要不用改
# - 如果你的网络访问 api.deepseek.com 不稳定，可改成自建代理
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 文本与 OpenCode 底座模型
DEEPSEEK_MODEL=deepseek-v4-flash


# ------------------------------------------------------------
# E2B OpenCode（Skills 工作台）
# ------------------------------------------------------------
# 在 https://e2b.dev/dashboard?tab=keys 创建 API Key。
# 每条 Skills 对话会创建一个独立的 E2B 沙箱。
E2B_API_KEY=e2b_your_api_key_here

# E2B 官方预装 OpenCode 的公共 Template
E2B_TEMPLATE=opencode
E2B_WORKDIR=/home/user/ues-workspace

# 沙箱空闲超时，Hobby 最大连续运行 1 小时；默认 30 分钟
E2B_SANDBOX_TIMEOUT_MS=1800000

# 上传/删除 Skills 的管理令牌
SKILLS_ADMIN_TOKEN=replace-with-a-long-random-token

# 整个站点的访问令牌。配置后，页面先登录，所有模型/对话/文件接口才可使用。
APP_ACCESS_TOKEN=replace-with-a-different-long-random-token
